DATABASE_URL=
API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
THEORIZER_PORT=9000

# Paper Finder (all optional; defaults target prod with nora-matching search settings)
PAPER_FINDER_BASE_URL=
PAPER_FINDER_WORKER_PROFILE=
PAPERFINDER_SEARCH_TIMEOUT_SECONDS=

# nora-retrieval olmOCR full text (PaperStore's first full-text source).
# All three are required -- the path is skipped, with a logged reason, unless
# every one is set. USE_NORA_RETRIEVAL_FULLTEXT is matched exactly against the
# lowercase string "true"; anything else (including "True" or "1") is off.
# NORA_RETRIEVAL_ENV picks which nora-retrieval deployment to read: "dev" or
# "prod", no default, so set it per environment.
USE_NORA_RETRIEVAL_FULLTEXT=
NORA_RETRIEVAL_ENV=
NORA_RETRIEVAL_BEARER_TOKEN=

# URL template for an authorized retrieval deployment, with optional {env}.
NORA_RETRIEVAL_BASE_URL_TEMPLATE=

# Optional authorized paper cache (disabled when unset).
PAPER_CACHE_BASE_URL=
